# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
# segundos que cada tentativa ao llm espera antes de desistir
LLM_TIMEOUT=5
# quantas vezes tentar o llm quando a falha e passageira
LLM_TENTATIVAS=3
# com 1, o llm falha de proposito para mostrar o disjuntor abrindo
LLM_FORCAR_FALHA=0
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
FILA_TIMEOUT_SEGUNDOS=30
# Pasta onde a ingestao grava o indice (indice.joblib)
DIR_DADOS=dados
